#!/bin/bash
# ============================================================
# netmon 安装后置处理
# 1) 创建桌面 UI 软链接
# 2) 初始化数据目录与默认配置
# 3) 确保脚本可执行权限
# ============================================================
APP_BASE="/var/apps/${TRIM_APPNAME:-netmon}"
APP_DEST="${TRIM_APPDEST}"

if [ -d "${APP_DEST}/ui" ] && [ ! -e "${APP_BASE}/ui" ]; then
    ln -s "${APP_DEST}/ui" "${APP_BASE}/ui" 2>/dev/null && echo "已创建 UI 软链接" || true
fi

mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true
if [ ! -f "${TRIM_PKGVAR}/config.json" ]; then
    echo "{\"interval\": 2, \"retention_days\": 7}" > "${TRIM_PKGVAR}/config.json"
fi

chmod +x "${APP_DEST}/server.py" 2>/dev/null || true

if [ -f "${APP_BASE}/manifest" ]; then
    cp -f "${APP_BASE}/manifest" "${APP_DEST}/manifest" 2>/dev/null || true
fi

echo "netmon 安装完成"
exit 0
